# Razorpay Test Mode credentials (required when checkout is implemented).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
OPERATOR_VIEW_TOKEN=replace_me
MANDATE_SIGNING_SECRET=replace_me
MERCHANT_ID=merchant_demo

# Optional Phase 8 model adapter. Choose a model that supports tool calling.
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=~openai/gpt-latest

# Local PostgreSQL service started by Docker Compose.
POSTGRES_DB=agentic_checkout
POSTGRES_USER=agentic_checkout
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://agentic_checkout:change-me@localhost:5432/agentic_checkout
